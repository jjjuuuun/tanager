{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(cmd.exe /c gradlew.bat *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase origin/dev)",
      "Bash(git push -u origin *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin *)",
      "Bash(gh issue create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh label list *)",
      "Bash(gh label create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh repo view *)",
      "Bash(gh api repos/*/milestones*)",
      "Bash(.github/scripts/sync-milestones.sh *)",
      "Bash(git cliff *)",
      "Bash(git merge-base *)",
      "Bash(git tag -l *)",
      "Bash(git rev-list *)",
      "Bash(gh api -X PATCH repos/*/milestones/*)"
    ],
    "ask": [
      "Bash(git push origin v*)",
      "Bash(git push --tags *)",
      "Bash(git push * --tags *)",
      "Bash(gh release create *)",
      "Bash(git reset --hard *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review * --approve *)",
      "Bash(gh release delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
